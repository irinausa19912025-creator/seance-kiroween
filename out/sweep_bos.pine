// generated from sweep_bos.json by Seance - do not edit by hand
// skeleton: Sweep to Break of Structure (sweep_bos v0.2.0)
// closed_candles_only: true
// detection_conflict: skip_both
// collision_policy: overwrite
//@version=6
indicator("Sweep to Break of Structure", overlay = true, max_labels_count = 500)

poolLen = input.int(20, "Pool length (candles)", minval = 5)
windowLen = input.int(12, "Setup window (candles after sweep)", minval = 1)

var int   side = 0
var int   sBar = 0
var float sHi  = na
var float sLo  = na

f_mark(string txt, color col) =>
    label.new(bar_index, na, txt, xloc = xloc.bar_index, yloc = yloc.belowbar,
              style = label.style_label_up, color = col,
              textcolor = color.white, size = size.tiny)

ph = ta.highest(high[1], poolLen)
pl = ta.lowest(low[1],  poolLen)

if barstate.isconfirmed
    if side != 0
        if side == 1
            if (high > sHi)
                f_mark("CANCEL", color.new(color.teal, 20))
                side := 0
            else if (close < sLo)
                f_mark("BOS", color.new(color.gray, 20))
                side := 0
            else if ((bar_index - sBar) >= windowLen)
                f_mark("EXPIRE", color.new(color.purple, 20))
                side := 0
        else if side == 2
            if (low < sLo)
                f_mark("CANCEL", color.new(color.teal, 20))
                side := 0
            else if (close > sHi)
                f_mark("BOS", color.new(color.gray, 20))
                side := 0
            else if ((bar_index - sBar) >= windowLen)
                f_mark("EXPIRE", color.new(color.purple, 20))
                side := 0
    if bar_index >= poolLen
        bool _d0 = ((high > ph) and (close <= ph))
        bool _d1 = ((low < pl) and (close >= pl))
        int _n = (_d0 ? 1 : 0) + (_d1 ? 1 : 0)
        if _n == 1
            if _d0
                f_mark("SWEEP_HIGH", color.new(color.orange, 20))
                side := 1
                sBar := bar_index
                sHi  := high
                sLo  := low
            else if _d1
                f_mark("SWEEP_LOW", color.new(color.blue, 20))
                side := 2
                sBar := bar_index
                sHi  := high
                sLo  := low
