"""Emit the Python reference implementation from a parsed Seance skeleton.

The emitter walks the parsed expression trees — the ``rules.expr`` AST nodes
carried by a :class:`rules.model.Skeleton` — and prints Python source for the
detections and the ordered resolutions.  Nothing in this module contains the
rule's conditions as literal text: every event name, comparison operator,
resolution order, the collision policy, the detection-conflict policy and
``closed_candles_only`` are read from the skeleton, so editing the skeleton
changes the generated reference.

The state machine is fixed: one pending observation at a time; on each bar the
pending observation is tested for resolution before a new detection is
considered; the pool is the extreme of the previous ``pool_len`` closed bars
and detection only starts once that many bars exist.
"""
import os
import pathlib
import sys

# Make the repository root importable so ``rules`` resolves whether this file
# is imported as generators.emit_python or run directly as a script (build.sh
# does the latter, from the repo root, with the script's own directory on
# sys.path rather than the repo root).
_REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
if _REPO not in sys.path:
    sys.path.insert(0, _REPO)

from rules.model import load
from rules import expr


# ── expression rendering ─────────────────────────────────────────────────── #

def _const_name(key: str) -> str:
    """Module-level constant name for a parameter key (upper-cased)."""
    return key.upper()


def _emit(node, vm: dict) -> str:
    """Render an expr AST node as a Python expression string.

    ``vm`` maps every identifier the tree may reference (built-in primary terms
    and parameter names) to the Python expression that supplies its value at
    runtime.  Parentheses are added only where Python's precedence would
    otherwise change the meaning the skeleton author wrote; the grammar's
    precedence (or < and < not < comparison) matches Python's, so flat output
    is correct except for explicit grouping the parser flattened away.
    """
    if isinstance(node, expr.Lit):
        return str(node.value)
    if isinstance(node, expr.Var):
        return vm[node.name]
    if isinstance(node, expr.Cmp):
        return f"{_emit(node.left, vm)} {node.op} {_emit(node.right, vm)}"
    if isinstance(node, expr.Not):
        operand = _emit(node.operand, vm)
        if isinstance(node.operand, (expr.And, expr.Or)):
            operand = f"({operand})"
        return f"not {operand}"
    if isinstance(node, expr.And):
        left = _emit(node.left, vm)
        right = _emit(node.right, vm)
        if isinstance(node.left, expr.Or):
            left = f"({left})"
        if isinstance(node.right, expr.Or):
            right = f"({right})"
        return f"{left} and {right}"
    if isinstance(node, expr.Or):
        left = _emit(node.left, vm)
        right = _emit(node.right, vm)
        if isinstance(node.left, expr.And):
            left = f"({left})"
        if isinstance(node.right, expr.And):
            right = f"({right})"
        return f"{left} or {right}"
    raise TypeError(f"cannot emit AST node {node!r}")


def _varmap(skel, ctx: str) -> dict:
    """Build the identifier -> Python-expression map for one context.

    ``ctx`` is "detection" (pool_high/pool_low available) or "resolution"
    (entry_high/entry_low and bars_since_entry available).  Declared parameters
    are available in both, as module-level constants.
    """
    vm = {"open": "o", "high": "h", "low": "l", "close": "c"}
    if ctx == "detection":
        vm["pool_high"] = "ph"
        vm["pool_low"] = "pl"
    else:
        vm["entry_high"] = 'pend["hi"]'
        vm["entry_low"] = 'pend["lo"]'
        vm["bars_since_entry"] = '(k - pend["i"])'
    for key in skel.params:
        vm[key] = _const_name(key)
    return vm


# ── skeleton -> source ───────────────────────────────────────────────────── #

def generate(skel, skel_filename: str) -> str:
    """Return the full Python source for the reference ``run`` for a Skeleton."""
    if skel.detection_conflict != "skip_both":
        raise NotImplementedError(
            f"detection_conflict {skel.detection_conflict!r} is not supported "
            "by the Python emitter (only 'skip_both')")
    if skel.collision_policy != "overwrite":
        raise NotImplementedError(
            f"collision_policy {skel.collision_policy!r} is not supported "
            "by the Python emitter (only 'overwrite')")

    pool_const = _const_name(skel.pool.lookback_param)
    rvm = _varmap(skel, "resolution")
    dvm = _varmap(skel, "detection")
    sides = sorted({d.side for d in skel.detections})

    L = []
    L.append(f"# generated from {skel_filename} — do not edit by hand")
    L.append(f"# skeleton: {skel.name} ({skel.id} v{skel.version})")
    L.append(f"# closed_candles_only: {str(skel.closed_candles_only).lower()}")
    L.append(f"# detection_conflict: {skel.detection_conflict}")
    L.append(f"# collision_policy: {skel.collision_policy}")
    L.append("")
    for key, p in skel.params.items():
        L.append(f"{_const_name(key)} = {p.default}")
    L.append("")
    L.append("")
    L.append("def run(bars):")
    L.append('    """bars: list of (time, open, high, low, close), oldest first.')
    L.append('    Returns a list of (time, event_name)."""')
    L.append("    ev = []")
    L.append("    pend = None")
    L.append('    for k, (t, o, h, l, c) in enumerate(bars):')

    # ── resolution: tested in skeleton order, only those whose "for" matches
    #    the pending side or is "any"; first match wins and clears pend.
    L.append("        if pend is not None:")
    for si, side in enumerate(sides):
        applicable = [r for r in skel.resolutions
                      if r.target == side or r.target == "any"]
        if si == 0:
            L.append(f'            if pend["side"] == "{side}":')
        else:
            L.append(f'            elif pend["side"] == "{side}":')
        if not applicable:
            L.append("                pass")
            continue
        for j, r in enumerate(applicable):
            cond = _emit(r.when, rvm)
            kw = "if" if j == 0 else "elif"
            L.append(f"                {kw} {cond}:")
            L.append(f'                    ev.append((t, "{r.event}")); pend = None')

    # ── detection: only once the pool has enough closed bars.  The pool is
    #    the extreme of the previous lookback closed bars.
    L.append(f"        if k >= {pool_const}:")
    L.append(f"            win = bars[k - {pool_const}:k]")
    L.append("            ph = max(b[2] for b in win); pl = min(b[3] for b in win)")
    flag_names = []
    for i, d in enumerate(skel.detections):
        cond = _emit(d.when, dvm)
        name = f"_d{i}"
        flag_names.append(name)
        L.append(f"            {name} = {cond}")
    # detection_conflict "skip_both": if more than one fires on the same bar,
    # neither starts; if exactly one fires, it starts.
    count_expr = " + ".join(f"(1 if {fn} else 0)" for fn in flag_names) or "0"
    L.append(f"            _n = {count_expr}")
    L.append("            if _n == 1:")
    for i, d in enumerate(skel.detections):
        kw = "if" if i == 0 else "elif"
        L.append(f"                {kw} {flag_names[i]}:")
        # collision_policy "overwrite": a new detection replaces any pending
        # observation with no resolution event.
        L.append(f'                    ev.append((t, "{d.event}")); '
                  f'pend = dict(side="{d.side}", i=k, hi=h, lo=l)')

    L.append("    return ev")
    return "\n".join(L) + "\n"


def main(skel_path, out_path):
    skel = load(skel_path)
    src = generate(skel, pathlib.Path(skel_path).name)
    pathlib.Path(out_path).write_text(src)
    print("written", out_path)


if __name__ == "__main__":
    main(sys.argv[1], sys.argv[2])
